# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/scripts/mobile-audit-out/

# local probe / temp artifacts (do not ignore tracked migrate/audit scripts)
/scripts/_tmp-*
/scripts/*probe*
/scripts/*debug*
/scripts/*.result.json
/scripts/audit-brand-source.mjs
/scripts/cart-direct-ae.mjs
/scripts/cart-plus-one-mutation.mjs
/scripts/cart-regression.mjs
/scripts/cart-ui-diagnose.mjs
/scripts/shop-api-timing.mjs
/supabase/.temp/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.tmp-*
.tmp-frames/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
