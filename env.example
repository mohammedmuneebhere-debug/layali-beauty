# Copy relevant keys into .env.local (never commit real secrets).
# Storefront (existing)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Shopify Admin — Dev Dashboard client credentials (server-only, no NEXT_PUBLIC_)
# Required app scopes for migration:
# write_products, write_inventory, read_locations, read_publications, write_publications
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Required for execute-mode migration mapping writes
SUPABASE_SERVICE_ROLE_KEY=

# Optional: pin inventory location if locations query is unavailable
# SHOPIFY_LOCATION_ID=gid://shopify/Location/123456789

# Shopify Customer Accounts (server-only). Leave unset until the Headless client exists.
# Also requires SHOPIFY_STORE_DOMAIN above. Routes stay disabled while any value is missing.
# Callback: https://www.layalibeautystore.com/api/customer-account/callback
# JavaScript origin: https://www.layalibeautystore.com
# Logout URI: https://www.layalibeautystore.com/
# SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=
# SHOPIFY_CUSTOMER_ACCOUNT_SHOP_ID=
# SHOPIFY_CUSTOMER_ACCOUNT_SESSION_SECRET=

# Optional: OpenAI-compatible API for Ask Laila (server-only).
# Without this, Laila still answers from the live Shopify catalog using the built-in advisor.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
