# Copy relevant keys into .env.local (never commit real secrets).
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Shopify Admin — Dev Dashboard client credentials (server-only, no NEXT_PUBLIC_)
# Required app scopes:
# read_products, write_products, read_orders, write_draft_orders, write_orders,
# read_customers, write_customers, write_files, read_inventory, write_inventory
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Optional: pin inventory location if locations query is unavailable
# SHOPIFY_LOCATION_ID=gid://shopify/Location/123456789

# Shopify Customer Accounts (server-only). Required for sign-in.
# Callback: https://www.layalibeautystore.com/api/customer-account/callback
# JavaScript origin: https://www.layalibeautystore.com
# Logout URI: https://www.layalibeautystore.com/
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=
SHOPIFY_CUSTOMER_ACCOUNT_SHOP_ID=
SHOPIFY_CUSTOMER_ACCOUNT_SESSION_SECRET=

# Preview only. Exactly one https origin, such as https://layali-staging.example.com.
# Leave this unset in production. An absent or invalid value disables staging sign-in.
# Also register these Customer Account URLs for that exact host:
# Callback: https://<host>/api/customer-account/callback
# JavaScript origin: https://<host>
# Logout: https://<host>/
# LAYALI_STAGING_ORIGIN=

# Staff emails, comma-separated. Compared with the verified Customer Account email.
# A customer who is not on this list cannot open /admin.
LAYALI_STAFF_EMAILS=

# Optional: OpenAI-compatible API for Ask Laila (server-only).
# Without this, Laila still answers from the live Shopify catalog using the built-in advisor.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
